{
  "schemaVersion": 1,
  "id": "beachparty",
  "version": "${version}",
  "name": "[Let's Do] Beachparty",
  "description": "Take a break - build sandcastles, drink cocktails and enjoy your Minecraft Session.",
  "authors": [
    "satisfy",
    "Jason13Official"
  ],
  "contributors": [
    "MissLilitu",
    "Iri",
    "Dev_Myst"
  ],
  "contact": {
    "homepage": "https://www.lets-do.ch",
    "wiki": "https://lets-do.ch/wiki/beachparty/",
    "sources": "https://github.com/Let-s-Do-Collection/Beachparty",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.beachparty.fabric.BeachpartyFabric"
    ],
    "client": [
      "net.satisfy.beachparty.fabric.client.BeachpartyFabricClient"
    ],
    "rei_client": [
      "net.satisfy.beachparty.fabric.core.rei.BeachpartyREIClientPluginFabric"
    ],
    "jei_mod_plugin": [
      "net.satisfy.beachparty.core.compat.jei.BeachpartyJEIPlugin"
    ],
    "emi": [
      "net.satisfy.beachparty.core.compat.emi.BeachpartyEmiPlugin"
    ],
    "modmenu": [
      "net.satisfy.beachparty.fabric.core.config.ModMenu"
    ]
  },
  "mixins": [
    "beachparty-common.mixins.json",
    "beachparty-wearables.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "architectury": ">=13.0.8",
    "foundation": ">=1.0.12",
    "cloth-config": "*"
  },
  "suggests": {
    "accessories": "*",
    "trinkets": "*"
  }
}
